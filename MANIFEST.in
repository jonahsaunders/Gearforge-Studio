include README.md CHANGELOG.md LICENSE THIRD_PARTY_NOTICES.md
include CONTRIBUTING.md SECURITY.md constraints-release.txt VALIDATION.json
recursive-include .github *.yml *.md
recursive-include docs *.md *.json
recursive-include packaging *.py *.spec *.sh *.bat *.command
recursive-include packaging/licenses *.txt
recursive-include scripts *.py
recursive-include tests *.py
recursive-include examples *.gearforge
prune examples/exported-*
recursive-include src/gearforge/data *.csv *.json *.svg *.png
